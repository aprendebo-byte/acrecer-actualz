# Base de datos PostgreSQL
DB_NAME="acrecer"
DB_USER="postgres"
DB_PASSWORD="cambiame"
# En local: localhost. En docker-compose se sobreescribe a "db".
DB_HOST="localhost"
DB_PORT="5432"

# Django
# DEBUG por defecto es False (se asume producción si la variable falta).
DEBUG="True"
# OBLIGATORIAS cuando DEBUG=False: el arranque falla si no están.
# SECRET_KEY="genera-una-clave-segura"
# ALLOWED_HOSTS="midominio.com,api.midominio.com"
# Zona horaria del negocio (afecta al informe y al cron).
# TIME_ZONE="America/Bogota"
# Confía en X-Forwarded-Proto del proxy que termina TLS (por defecto, si no hay DEBUG).
# USE_X_FORWARDED_PROTO="True"

# Endurecimiento HTTPS. Las cookies seguras se activan solas cuando DEBUG=False;
# si el despliegue sirve por HTTP plano hay que desactivarlas o el admin no dejará
# iniciar sesión.
# SESSION_COOKIE_SECURE="False"
# CSRF_COOKIE_SECURE="False"
# Activa la redirección a HTTPS solo si el proxy informa bien el esquema
# (USE_X_FORWARDED_PROTO), de lo contrario provoca un bucle de redirecciones.
# SECURE_SSL_REDIRECT="True"
# HSTS: difícil de revertir. Actívalo cuando el dominio sirva solo TLS.
# SECURE_HSTS_SECONDS="31536000"
# SECURE_HSTS_INCLUDE_SUBDOMAINS="True"
# SECURE_HSTS_PRELOAD="True"

# Correo (Gmail SMTP)
EMAIL_USER="cuenta@gmail.com"
EMAIL_PASSWORD="app-password-de-gmail"
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORT="587"

# Destinatarios de las notificaciones de negocio y del informe.
NOTIFICACION_DESTINATARIOS="persona1@ejemplo.com,persona2@ejemplo.com"

# Mobilia
MOBILIA_USER="usuario"
MOBILIA_PASSWORD="password"
MOBILIA_URL="https://..."
MOBILIA_API_KEY="..."
# Segundos que se cachea el listado de inmuebles activos. 0 desactiva la cache.
# MOBILIA_CACHE_TTL="120"

# Memoria temporal (conversación viva). En docker-compose se fija a redis://redis:6379/0
# REDIS_URL="redis://localhost:6379/0"

# API de envío de plantillas de WhatsApp. Sin defaults en el código: si falta la
# URL o el template, el envío falla de forma explícita en lugar de silenciosa.
WHATSAPP_API_URL="https://..."
WHATSAPP_API_TOKEN="..."
WHATSAPP_DEFAULT_TEMPLATE_ID_ARR="..."

# Webhook de n8n que registra el contacto en PostgreSQL tras enviar la plantilla.
# Déjalo vacío o sin definir para desactivar la notificación.
N8N_GUARDAR_PG_WEBHOOK=""

# Ventana en días del informe de historial. 0 = todo el histórico.
# INFORME_DIAS="30"

# Token que autoriza la CONSULTA del historial (/api/automations/historial/...).
# Sin él esos endpoints responden 403 (fallan cerrado). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
API_INFORMES_TOKEN="genera-un-token-largo-y-aleatorio"
